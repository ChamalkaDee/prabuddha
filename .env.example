# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# DATABASE_URL  pooled connection (port 6543) — used by the running app via
#               the Prisma driver adapter.
# DIRECT_URL    direct connection (port 5432) — used by migrations only,
#               read from prisma.config.ts.
# Prisma 7 keeps these OUT of schema.prisma. Do not add them back there.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Supabase Storage — powers book cover uploads.
# Both are on the Supabase dashboard under Settings → API.
# The service role key bypasses row-level security: server-side only,
# never prefix it with NEXT_PUBLIC_.
SUPABASE_URL="https://YOURPROJECTREF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Auth.js
# AUTH_SECRET: generate with `npx auth secret`
# ---------------------------------------------------------------------------
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — from Google Cloud Console
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend — powers both the email sign-in link and the loan emails
AUTH_RESEND_KEY=""
EMAIL_FROM="library@yourdomain.com"

# ---------------------------------------------------------------------------
# Library settings
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAILS="chamalka.dharmadasa@gmail.com,lashramesh@gmail.com"
SHOP_DETAILS="the distributor shop, 12 High Street — open Sat 10am-4pm"

# Protects the daily reminder cron. Any long random string.
CRON_SECRET=""
